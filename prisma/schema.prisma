generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  firstName       String?
  lastName        String?
  avatarUrl       String?
  password        String?   // null for OAuth users
  sgsRole         String    @default("user") // "user", "admin", "moderator", "dev"
  language        String    @default("fr")
  theme           String    @default("dark")
  bannerUrl       String?
  bannerOffsetY   Int       @default(50)
  smartRating     Boolean   @default(true)
  isPublic        Boolean   @default(false)
  videoLoop       Boolean   @default(true)
  videoLoopDelay  Int       @default(500)
  hiddenStats     String    @default("[]")
  enforcePublicStats Boolean @default(false)
  dashboardGrid   String?
  voiceSettings   String?   // JSON string storing { inputDeviceId, outputDeviceId, voiceIsolation, autoDucking, speakingThreshold, audioQuality }
  badge           String?   // "verified", "pro", "creator", "vip", "dev", "moderator"
  showBadge       Boolean   @default(true)
  riotGameName    String?
  riotConnected   Boolean   @default(false)
  riotPuuid       String?
  googleConnected Boolean   @default(false)
  googleEmail     String?
  onboardingDone  Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  accounts        Account[]
  sessions        Session[]
  sentFriendships     Friendship[] @relation("UserFriendships")
  receivedFriendships Friendship[] @relation("FriendOfUser")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// CMS (AppControl Staging -> Prod)
// ==========================================

model News {
  id            String   @id @default(cuid())
  title         String
  nodes         String   // JSON contenant l'arbre de décision
  currentNodeId String?
  isDraft       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Agent {
  id          String   @id @default(cuid())
  uuid        String   @unique
  name        String
  role        String
  iconUrl     String?
  abilities   String   // JSON contenant les descriptions riches des compétences
  isDraft     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Map {
  id          String   @id @default(cuid())
  uuid        String   @unique
  name        String
  splashUrl   String?
  isDraft     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Banner {
  id          String   @id @default(cuid())
  name        String
  wideArtUrl  String
  isDraft     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// Analytics & Media Metrics
// ==========================================

model PageVisit {
  id        String   @id @default(cuid())
  path      String
  pageName  String   @default("Accueil")
  userAgent String?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

model MediaLoad {
  id        String   @id @default(cuid())
  mediaKey  String
  mediaType String   @default("video")
  bytesSent BigInt   @default(0)
  createdAt DateTime @default(now())

  @@index([mediaKey])
  @@index([createdAt])
}

// ==========================================
// LFG Salons & Modération (Neon DB)
// ==========================================

model Lobby {
  id               String                 @id @default(cuid())
  leaderName       String
  leaderTag        String
  leaderRank       String
  leaderRankUrl    String?
  leaderRankTier   Int                    @default(12)
  isLeaderPrivate  Boolean                @default(false)
  leaderAvatar     String?
  mode             String                 @default("Compétitif")
  roleNeeded       String                 @default("[\"Tous Rôles\"]")
  micRequired      String                 @default("yes")
  maxSlots         Int                    @default(5)
  currentSlots     Int                    @default(1)
  note             String?
  region           String                 @default("EU / Paris")
  lobbyLevel       String                 @default("Or")
  lobbyLevelTier   Int                    @default(12)
  membersData      String                 @default("[]")
  voiceMembersData String                 @default("[]")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  expiresAt        DateTime               @default(now())
  messages         LobbyMessage[]
  transcripts      LobbyVoiceTranscript[]

  @@index([createdAt])
  @@index([expiresAt])
}

model LobbyMessage {
  id           String   @id @default(cuid())
  lobbyId      String
  senderName   String
  senderTag    String
  senderAvatar String?
  content      String
  isToxic      Boolean  @default(false)
  createdAt    DateTime @default(now())

  lobby        Lobby    @relation(fields: [lobbyId], references: [id], onDelete: Cascade)

  @@index([lobbyId])
}

model LobbyVoiceTranscript {
  id         String   @id @default(cuid())
  lobbyId    String
  senderName String
  senderTag  String
  content    String
  isToxic    Boolean  @default(false)
  createdAt  DateTime @default(now())

  lobby      Lobby    @relation(fields: [lobbyId], references: [id], onDelete: Cascade)

  @@index([lobbyId])
}

model LobbyArchive {
  id               String   @id @default(cuid())
  lobbyId          String
  leaderName       String
  leaderTag        String
  mode             String
  region           String   @default("EU / Paris")
  lobbyLevel       String   @default("Or")
  lobbyLevelTier   Int      @default(12)
  totalMembers     Int      @default(1)
  membersList      String   @default("[]") // JSON string of participating members
  closedReason     String   @default("empty") // "empty", "leader_closed", "expired"
  createdAt        DateTime // Original lobby creation time
  closedAt         DateTime @default(now())
  messagesCount    Int      @default(0)
  transcriptsCount Int      @default(0)
  recordsData      String   @default("[]") // JSON of all chat messages and voice transcripts with timestamps, senders and present viewers

  @@index([lobbyId])
  @@index([closedAt])
}

// ==========================================
// SGS Global Hub & Legal Management
// ==========================================

model SgsLegalSettings {
  id              String   @id @default("sgs_default_legal")
  companyName     String   @default("SGS (Smart Gaming Suite)")
  contactEmail    String   @default("contact@sgs.gg")
  contactAddress  String?  @default("Paris, France")
  hostName        String   @default("Vercel Inc.")
  hostAddress     String   @default("440 N Barranca Ave #4133, Covina, CA 91723, USA")
  dbHost          String   @default("Neon Tech Inc., San Francisco, USA")
  storageHost     String   @default("Cloudflare Inc., San Francisco, USA")
  cguText         String   @default("")
  mentionsLegales String   @default("")
  privacyPolicy   String   @default("")
  riotDisclaimer  String   @default("")
  updatedAt       DateTime @updatedAt
}

model SgsService {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  url         String
  iconUrl     String?
  status      String   @default("active") // "active", "beta", "maintenance", "soon"
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// Système d'Amis Social (SGS Friends)
// ==========================================

model Friendship {
  id           String    @id @default(cuid())
  userId       String    // Demandeur ou propriétaire de la relation
  friendId     String?   // Destinataire (si inscrit sur SGS Tracker)
  targetRiotId String?   // Riot ID ciblé (ex: "TenZ#NA1") pour inviter n'importe quel joueur
  status       String    @default("pending") // "pending", "accepted", "declined", "blocked"
  canViewStats Boolean   @default(true) // Autorisation d'accès aux stats privées pour cet ami
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friend       User?     @relation("FriendOfUser", fields: [friendId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([friendId])
  @@index([targetRiotId])
  @@index([status])
}
